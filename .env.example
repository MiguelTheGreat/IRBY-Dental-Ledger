# Copy to .env and adjust. Every setting is optional.

# --- Server ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0                 # 0.0.0.0 = reachable from clinic tablets on the LAN
# HTTPS=true                 # needed for the live camera preview on tablets (run: npm run cert)
# HTTPS_PORT=3443
# TLS_CERT=data/certs/cert.pem
# TLS_KEY=data/certs/key.pem

# --- Data & encryption ----------------------------------------------------
# DATA_DIR=data              # database, master key and backups live here
# MASTER_KEY_FILE=data/master.key
# MASTER_KEY=                # base64 32-byte key (overrides the key file; keep it secret)
# BACKUPS=true               # daily encrypted Backup_YYYYMMDD_Secure.bak
# BACKUP_DIR=data/backups
# BACKUP_KEEP=30
# TRASH_RETENTION_DAYS=30    # soft-deleted records recoverable for at least 30 days

# --- Security -------------------------------------------------------------
# IDLE_MINUTES=10            # NFR-SEC1 idle auto-logout

# --- OCR (FR-8) - Keras Document Classifier + EasyOCR (ocr-model/server.py) ---
OCR_PROVIDER=http            # mock | http | command | module
OCR_TIMEOUT_MS=30000
OCR_HTTP_URL=http://127.0.0.1:8765/predict
OCR_HTTP_HEALTH_URL=http://127.0.0.1:8765/health
# OCR_HTTP_AUTH=Bearer change-me
# OCR_COMMAND=python ocr-model/infer.py {image}
# OCR_MODULE=ocr-model/js-provider.example.js

# --- Upload limits ----------------------------------------------------------
# PHOTO_MAX_BYTES=8388608    # clinical photos (the portrait limit is fixed at 500 KB by FR-1)
# SCAN_MAX_BYTES=12582912
